generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  transactions Transaction[]
  categories   Category[]
  accounts     Account[]

  @@map("users")
}

model Transaction {
  id              Int             @id @default(autoincrement())
  transactionType TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  transactionDate DateTime        @default(now())
  description     String?         @db.VarChar(255)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user       User     @relation(fields: [userId], references: [id])
  userId     Int

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  account    Account  @relation(fields: [accountId], references: [id])
  accountId  Int

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])

  @@map("transactions")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  description String?   

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id])
  userId       Int

  transactions Transaction[]

  @@unique([userId, name])
  @@map("categories")
}

model Account {
  id          Int         @id @default(autoincrement())
  name        String
  accountType AccountType
  provider    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id])
  userId       Int

  transactions Transaction[]

  @@unique([userId, name])
  @@map("accounts")
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum AccountType {
  CASH
  BANK
  WALLET
  CREDIT_CARD
}